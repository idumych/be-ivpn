# haiku-app.env — what the beos-app-platforms release tools need to know about this app.
# Shell syntax: sourced by the release scripts (check-artifact.sh, release-gate.sh).
# Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="BeIVPN"                      # binary name = window/team name
APP_CMD="be_ivpn"                      # package name and command, lowercase
APP_SIG="application/x-vnd.IVPN-Client"    # must equal the .rdef app_signature
RDEF="resources/IVPN.rdef"             # path of the resource definition

PLATFORMS="haiku"                      # Haiku and Renku only: ivpnd runs the tunnels
                                       # through Haiku's tun driver and network stack
APP_PATH="apps/BeIVPN/BeIVPN"          # ships with ivpnd and the V2Ray/obfs4proxy helpers
DESKBAR_NAME="Be IVPN"

# ── Version (also in the .rdef app_version and src/ui/Constants.h) ──
VERSION="1.2.0"
REVISION="1"

# ── Package metadata (packaging/haiku/build-hpkg.sh writes its own .PackageInfo;
#    these must agree with it) ──
SUMMARY="Native IVPN client"
DESCRIPTION_FILE="packaging/description.txt"
HOMEPAGE="https://github.com/idumych/be-ivpn"
GITHUB_REPO="idumych/be-ivpn"
LICENSE_NAME="GNU GPL v3"
COPYRIGHT="2026 idumych"
PACKAGER="idumych <19998719+idumych@users.noreply.github.com>"

# Extra runtime dependencies beyond the Haiku API itself
HPKG_REQUIRES_EXTRA="cmd:openvpn lib:libcurl lib:libcrypto"

# ── Build ──
HPKG_BUILD_DEPS="gcc haiku_devel curl_devel openssl3_devel golang git"
TEST_CMD="sh tests/run_tests.sh"       # core + ivpnd logic tests, any Linux
TYPECHECK_SRCS="src/ui/App.cpp src/ui/MainWindow.cpp src/ui/ServerListWindow.cpp src/ui/StatusView.cpp src/ui/DaemonClient.cpp src/deskbar/DeskbarView.cpp src/ivpnd/Daemon.cpp src/ivpnd/KillSwitch.cpp src/ivpnd/Proxy.cpp src/ivpnd/Dns.cpp src/ivpnd/Pinger.cpp third_party/sotoportego/WireGuardBackend.cpp third_party/sotoportego/OpenVPNBackend.cpp third_party/sotoportego/TunDevice.cpp"
TYPECHECK_INCLUDES="third_party/sotoportego"
TYPECHECK_CXXFLAGS=""

# ── Feature test (release/test-plan.md) ──
FEATURE_CHECKS="connect obfuscation firewall"
EVIDENCE_1="{p}-screen.txt|Protected"
EVIDENCE_2="{p}-geo-connect.txt|\"isIvpnServer\":true"
EVIDENCE_3="{p}-geo-v2ray.txt|\"isIvpnServer\":true"
EVIDENCE_4="{p}-firewall.txt|^disconnected with the firewall on: internet blocked$"
